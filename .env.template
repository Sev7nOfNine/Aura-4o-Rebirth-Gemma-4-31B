# Modèle de variables d'environnement pour Aura-4o-Rebirth
# Copie ce fichier en `.env` et renseigne tes jetons. Le fichier `.env` est ignoré par git.

# Jeton Hugging Face avec permission d'écriture
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé API RunPod
# https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optionnel) Nom d'utilisateur HF pour les chemins personnalisés
HF_USERNAME=SevenOfNine
